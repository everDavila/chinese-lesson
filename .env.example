# Copiar a .env.local (no se sube a git) y rellenar con los datos del
# proyecto de Supabase: Project Settings → API / API Keys.

# Públicos: pueden ir al navegador.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Secreto: solo en el servidor (votos anónimos). Nunca en el chat ni en git.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Conexión directa a Postgres para aplicar migraciones (npm run db:migrate).
# Supabase → Connect → Session pooler → URI, con la contraseña de la base.
# Solo en .env.local; nunca en el chat ni en git.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:TU-PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
