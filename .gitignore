# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# caché local de la CLI de Supabase
/supabase/.temp/

# Playwright
/tests/.results/
/tests/screens/
/playwright-report/

# archivos temporales de Office (documento abierto)
~$*

# Material de Ever para consultar (no va al repo)
/input-externo/

# Copias de seguridad de la base (datos reales, nunca al repo)
/backups/

# Sesiones guardadas para los recorridos (son llaves: nunca al repo)
/tests/.auth/
/tests/.auth-dev/

# Caché de fuentes externas para construir lotes de contenido
/.cache/

# Capturas para la bitácora: se quedan en la PC, no se suben
/bitacora-capturas/

# Salida generada por Graphify
/graphify-out/
